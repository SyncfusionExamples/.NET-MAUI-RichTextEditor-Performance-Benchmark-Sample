<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SfRTEPerformance.BenchmarkPage"
             Title="SfRichTextEditor Benchmarks">

    <!--
        The whole page is one vertical stack with two regions:
          1. The action buttons (header + 5 buttons) — wrapped in a ScrollView
             so they remain reachable on very short screens, but normally sit
             at the top of the page.
          2. The results section — fixed 240 px height, pinned to the bottom
             of the viewport. Fixed height guarantees the results panel can
             never visually overlap the buttons above it.
    -->
    <Grid Padding="16" RowSpacing="12"
          RowDefinitions="*,240">

        <!-- Region 1: header + buttons -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="10">

                <VerticalStackLayout Spacing="4">
                    <Label Text="SfRichTextEditor Performance Benchmarks"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Tap a button to run a benchmark. Results are appended below."
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>

                <!-- Section 1: Initial Load — click a button, the editor
                     page is constructed with the matching HTML pre-assigned
                     in the constructor, and the time from click to first
                     paint is measured. -->
                <Label Text="Initial Load (HTML pre-assigned in constructor)"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <Button x:Name="InitialLoadEmptyButton"
                        Text="Run Initial Load (Empty)"
                        Clicked="OnRunInitialLoadEmptyClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="InitialLoad10KbButton"
                        Text="Run Initial Load (10 KB)"
                        Clicked="OnRunInitialLoad10KbClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="InitialLoad500KbButton"
                        Text="Run Initial Load (500 KB)"
                        Clicked="OnRunInitialLoad500KbClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="InitialLoad1MbButton"
                        Text="Run Initial Load (1 MB)"
                        Clicked="OnRunInitialLoad1MbClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="TenKParagraphsButton"
                        Text="Run 10,000 Paragraph Benchmark"
                        Clicked="OnRunTenKParagraphsClicked"
                        HorizontalOptions="Fill" />

                <!-- Section 2: Dynamic Value Update — re-assigns the
                     Value property on an already-loaded editor four
                     times (10 KB, 100 KB, 500 KB, 1 MB). -->
                <Label Text="Dynamic Value Update (re-assign Value on a loaded editor)"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <Button x:Name="DynamicValueButton"
                        Text="Run Dynamic Value Update Benchmark"
                        Clicked="OnRunDynamicValueClicked"
                        HorizontalOptions="Fill" />

                <!-- Section 3: Apply Format — opens a page with the editor
                     and a row of basic formatting buttons. Time from button
                     click to FormatChanged event is measured. -->
                <Label Text="Apply Format (from click to FormatChanged event)"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <Button x:Name="ApplyFormatButton"
                        Text="Apply Format"
                        Clicked="OnRunApplyFormatClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="ClearResultsButton"
                        Text="Clear Results"
                        Clicked="OnClearResultsClicked"
                        BackgroundColor="Gray"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Region 2: results panel. Fixed 240 px height so it never grows
             into the buttons above it, regardless of how many lines of text
             the Label contains. -->
        <Border Grid.Row="1"
                Stroke="LightGray"
                StrokeThickness="1"
                Padding="12">
            <ScrollView>
                <Label x:Name="ResultsLabel"
                       Text="Results will appear here."
                       FontFamily="OpenSansRegular"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
