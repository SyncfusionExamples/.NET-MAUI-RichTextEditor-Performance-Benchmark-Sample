<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SfRTEPerformance.BenchmarkPage"
             Title="SfRichTextEditor Benchmarks">

    <!--
        Two regions stacked vertically:
          Row 0: action buttons inside a ScrollView (in case the screen is short)
          Row 1: fixed-height results panel pinned to the bottom
    -->
    <Grid Padding="16" RowSpacing="12"
          RowDefinitions="*,240">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="10">

                <VerticalStackLayout Spacing="4">
                    <Label Text="SfRichTextEditor Performance Benchmarks"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Tap a button to run a benchmark. Results are appended below."
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>

                <!-- Initial Load: from click to the document being rendered.
                     One button per word-count scenario. -->
                <Label Text="Initial Load (measured until the content is actually rendered)"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <Button x:Name="InitialLoadEmptyButton"
                        Text="Run Initial Load (Empty)"
                        Clicked="OnRunInitialLoadEmptyClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="InitialLoad1000Button"
                        Text="Run Initial Load (1000 Words)"
                        Clicked="OnRunInitialLoad1000Clicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="InitialLoad5KButton"
                        Text="Run Initial Load (5,000 Words)"
                        Clicked="OnRunInitialLoad5KClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="InitialLoad10KButton"
                        Text="Run Initial Load (10,000 Words)"
                        Clicked="OnRunInitialLoad10KClicked"
                        HorizontalOptions="Fill" />

                <!-- Dynamic Value Update: opens a primed editor page with the three
                     scenario buttons (100 / 5K / 10K Words) shown on the
                     editor page itself. Each tap on those buttons times
                     one Value reassignment on the SAME editor instance. -->
                <Label Text="Dynamic Value Update (three per-scenario buttons appear on the editor page)"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <Button x:Name="DynamicValueButton"
                        Text="Run Dynamic Value Update Benchmark"
                        Clicked="OnRunDynamicValueClicked"
                        HorizontalOptions="Fill" />

                <!-- Apply Format: opens a page with the editor and a row of
                     format buttons. Time from click to FormatChanged is measured. -->
                <Label Text="Apply Format (from click to FormatChanged event)"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <Button x:Name="ApplyFormatButton"
                        Text="Apply Format"
                        Clicked="OnRunApplyFormatClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="ClearResultsButton"
                        Text="Clear Results"
                        Clicked="OnClearResultsClicked"
                        BackgroundColor="Gray"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                Stroke="LightGray"
                StrokeThickness="1"
                Padding="12">
            <ScrollView>
                <Label x:Name="ResultsLabel"
                       Text="Results will appear here."
                       FontFamily="OpenSansRegular"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>