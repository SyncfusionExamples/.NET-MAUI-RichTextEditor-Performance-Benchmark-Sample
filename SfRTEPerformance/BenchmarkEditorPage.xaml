<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:rte="clr-namespace:Syncfusion.Maui.RichTextEditor;assembly=Syncfusion.Maui.RichTextEditor"
             x:Class="SfRTEPerformance.BenchmarkEditorPage"
             Title="SfRichTextEditor">

    <Grid RowDefinitions="Auto,Auto,*" Padding="10">

        <!-- Result banner shown at the top of the editor page. Updated by
             the benchmark with the measured time once the editor has ingested
             the assigned document. -->
        <Label x:Name="ResultLabel"
               Grid.Row="0"
               Padding="16,12"
               FontSize="14"
               TextColor="White"
               BackgroundColor="#512BD4"
               LineBreakMode="WordWrap" />

        <!-- Dynamic Value Update buttons. Visible only when the editor was
             opened in Dynamic Value mode (one button per scenario, all
             measuring a Value reassignment on the SAME editor instance).
             Hidden for Initial Load scenarios. -->
        <HorizontalStackLayout x:Name="DynamicButtonRow"
                               Grid.Row="1"
                               IsVisible="False"
                               Spacing="6"
                               Margin="0,8,0,8"
                               HorizontalOptions="Start">
            <Button x:Name="DynamicValue100Button"
                    Text="100 Words"
                    Clicked="OnDynamicValue100Clicked" />
            <Button x:Name="DynamicValue5KButton"
                    Text="5,000 Words"
                    Clicked="OnDynamicValue5KClicked" />
            <Button x:Name="DynamicValue10KButton"
                    Text="10,000 Words"
                    Clicked="OnDynamicValue10KClicked" />
        </HorizontalStackLayout>

        <!-- The SfRichTextEditor under measurement. -->
        <rte:SfRichTextEditor x:Name="richTextEditor"
                              Grid.Row="2"
                              VerticalOptions="Fill"
                              HorizontalOptions="Fill" />
    </Grid>
</ContentPage>